{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "codexbot",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-11-13",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"preview_urls": false,
	"send_metrics": false,
	"routes": [],
	"secrets": {
		"required": [
			"GITHUB_PRIVATE_KEY",
			"GITHUB_WEBHOOK_SECRET"
		]
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": false
		},
		"traces": {
			"enabled": false,
			"head_sampling_rate": 0
		}
	},
	"vars": {
		"PUBLIC_URL": "https://codexbot.appsolves.workers.dev",
		"GITHUB_APP_ID": "5754181",
		"GITHUB_APP_SLUG": "codexbot-review",
		"TRUSTED_WORKFLOW": "AppSolves/codexbot/.github/workflows/review.yml@29c62540ac880db0afc34cf68c02be7368cb1551",
		"CHATGPT_DEPLOYMENT_AUTHORIZED": "true",
		"MERGE_DEPLOYMENT_AUTHORIZED": "false",
		"MERGE_ACCEPTANCE_REPOSITORY_ID": "",
		"MERGE_ACCEPTANCE_INSTALLATION_ID": "",
		"WEB_ENABLED": "false",
		"GITHUB_CLIENT_ID": "Iv23liRS1tl8zCodzTEr",
		"OPENAI_WEB_CLIENT_ID": "",
		"OPENAI_WEB_AUTH_METHOD": "",
		"OPENAI_WEB_SCOPES": "",
		"OPENAI_HOSTED_INFERENCE_AUTHORIZED": "false"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "codexbot",
			"database_id": "45bd9cde-59e9-41d0-a348-a993e6747192",
			"migrations_dir": "migrations"
		}
	],
	"triggers": {
		"crons": [
			"* * * * *",
			"*/2 * * * *"
		]
	}
}
