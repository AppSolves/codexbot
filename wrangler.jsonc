{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "codexbot",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-11-13",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"send_metrics": false,
	"secrets": {
		"required": [
			"GITHUB_PRIVATE_KEY",
			"GITHUB_WEBHOOK_SECRET"
		]
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": false
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.01
		}
	},
	"vars": {
		"PUBLIC_URL": "https://codexbot.appsolves.workers.dev",
		"GITHUB_APP_ID": "5754181",
		"GITHUB_APP_SLUG": "codexbot-review",
		"TRUSTED_WORKFLOW": "AppSolves/codexbot/.github/workflows/review.yml@14183bc5196ed5a23167a096270019e07f61dce6",
		"CHATGPT_DEPLOYMENT_AUTHORIZED": "false",
		"MERGE_DEPLOYMENT_AUTHORIZED": "false"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "codexbot",
			"database_id": "45bd9cde-59e9-41d0-a348-a993e6747192",
			"migrations_dir": "migrations"
		}
	],
	"triggers": {
		"crons": [
			"* * * * *"
		]
	}
}
